{
  "name": "destino-espanha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-cloudflare.mjs",
    "check:public": "node scripts/check-public-bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run check:public && npm test",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "deploy:dry-run": "npm run check && wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
