{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Worker + Static Assets.
  // O build copia somente os arquivos públicos para .cloudflare-dist.
  "name": "destino-espanha",
  "account_id": "55057a6f624af0b23eefddb19302e757",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "workers_dev": true,
  "secrets": {
    "required": ["TRACKING_390344_CONFIG"]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./.cloudflare-dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/whatsapp",
      "/whatsapp/*",
      "/WHATSAPP",
      "/WHATSAPP/*",
      "/acompanhar/3903444641a3371ce99f2b56",
      "/acompanhar/3903444641a3371ce99f2b56/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
